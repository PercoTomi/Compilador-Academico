  92  pinvocacion : expresion FLECHA ID
  93              | TRUNC '(' expresion ')' FLECHA ID
  94              | TRUNC '(' expresion FLECHA ID
  95              | TRUNC expresion ')' FLECHA ID
  96              | TRUNC expresion FLECHA ID
  97              | '(' tipo ID ')' '{' listasentencia '}'
  98              | '(' tipo ID ')' '{' listasentencia
