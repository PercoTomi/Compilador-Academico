  33          | IF '(' condicion ')' '{' '}' ELSE '{' listasentencia '}' ENDIF
  34          | IF '(' condicion ')' '{' '}' ENDIF
  35          | IF '(' condicion ')' '{' '}' ELSE '{' '}' ENDIF
  36          | DO '{' listasentencia '}' UNTIL condicion ')'
  37          | DO '{' listasentencia '}' UNTIL '(' condicion
  38          | DO '{' listasentencia '}' UNTIL condicion
  39          | DO '{' '}' UNTIL '(' condicion ')'
  40          | DO '{' listasentencia '}' '(' condicion ')'

  41  print : PRINT '(' expresion ')'
  42        | PRINT '(' CADENAML ')'
  43        | PRINT '(' ')'

  44  condicion : expresion comparador expresion
  45            | expresion expresion

  46  comparador : '>'
  47             | '<'
  48             | MAYORIG
  49             | MENORIG
  50             | IGUAL
  51             | DISTINTO

  52  tipo : LONG
  53       | LAMBDA

  54  identificador : ID
  55                | identificador '.' ID

  56  listavariables : listavariables ',' identificador
  57                 | identificador
  58                 | listavariables ID
  59                 | listavariables identificador '.' ID

  60  listaparametros : listaparametros ',' parametro
  61                  | parametro

  62  parametro : CV tipo ID
  63            | tipo ID
  64            | CV tipo
  65            | tipo
  66            | CV ID
  67            | ID

  68  expresion : expresion '+' termino
  69            | expresion '-' termino
  70            | termino
  71            | expresion '+' error
  72            | expresion '-' error
  73            | error '+' termino
  74            | error '-' termino
  75            | expresion error termino

  76  termino : termino '*' factor
  77          | termino '/' factor
  78          | factor
  79          | termino '*' error
  80          | termino '/' error
  81          | error '*' factor
  82          | error '/' factor

  83  factor : identificador
  84         | CTE
  85         | funcion

  86  funcion : ID '(' listapinvocacion ')'
