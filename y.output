   0  $accept : prog $end

   1  $$1 :

   2  $$2 :

   3  prog : ID $$1 bloque_sentencias $$2 EOF
   4       | bloque_sentencias EOF

   5  bloque_sentencias : '{' listasentencias '}'
   6                    | '{' '}'
   7                    | '{' listasentencias
   8                    | listasentencias '}'
   9                    | listasentencias

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion

  16  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  17                             | sentenciaejecutable ';'
  18                             | listasentenciasejecutables sentenciaejecutable
  19                             | sentenciaejecutable

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | funcion
  23                      | print
  24                      | funcion_lambda
  25                      | sentencia_return

  26  declaracion : tipo listaIDs

  27  $$3 :

  28  $$4 :

  29  declaracion : tipo id_funcion $$3 parametros_declaracion_f $$4 '{' listasentencias '}'

  30  parametros_declaracion_f : '(' listaparametros ')'
  31                           | '(' ')'

  32  listaparametros : listaparametros ',' parametro_formal
  33                  | parametro_formal

  34  parametro_formal : CV tipo ID
  35                   | tipo ID
  36                   | CV tipo
  37                   | tipo
  38                   | CV ID
  39                   | ID

  40  id_funcion : ID

  41  sentencia_return : RETURN '(' expresion ')'
  42                   | RETURN '(' ')'

  43  asignacion : identificador ASIG expresion
  44             | listavariables '=' listaconstantes

  45  bloque_control_estructura : '{' listasentenciasejecutables '}'
  46                            | sentenciaejecutable ';'
  47                            | '{' '}'

  48  $$5 :

  49  bloque_control : $$5 bloque_control_estructura

  50  inicio_do : DO

  51  $$6 :

  52  bloque_control_else : $$6 bloque_control

  53  control : IF condicion bloque_control ENDIF
  54          | IF condicion bloque_control ELSE bloque_control_else ENDIF
  55          | inicio_do bloque_control UNTIL condicion
  56          | IF condicion bloque_control ELSE bloque_control_else
  57          | IF condicion bloque_control
  58          | IF condicion bloque_control ELSE ENDIF
  59          | IF condicion ELSE bloque_control_else ENDIF
  60          | IF condicion ENDIF
  61          | IF condicion ELSE ENDIF
  62          | DO UNTIL condicion
  63          | inicio_do bloque_control condicion

  64  print : PRINT '(' expresion ')'
  65        | PRINT '(' CADENAML ')'
  66        | PRINT '(' ')'

  67  condicion : '(' cuerpocondicion ')'
  68            | cuerpocondicion ')'
  69            | '(' cuerpocondicion
  70            | cuerpocondicion

  71  cuerpocondicion : expresion comparador expresion
  72                  | expresion

  73  comparador : '>'
  74             | '<'
  75             | MAYORIG
  76             | MENORIG
  77             | IGUAL
  78             | DISTINTO

  79  tipo : LONG
  80       | LAMBDA

  81  listaIDs : listaIDs ',' ID
  82           | ID

  83  listavariables : listavariables ',' identificador
  84                 | identificador

  85  identificador : ID
  86                | identificador '.' ID

  87  funcion : cabecera_funcion argumentos_funcion ')'

  88  funcion_lambda : cabecera_funcion argumento_id_lambda ')'
  89                 | cabecera_funcion CTE ')'
  90                 | cabecera_funcion '-' CTE ')'
  91                 | cabecera_funcion TRUNC '(' CTE ')' ')'
  92                 | cabecera_funcion TRUNC '(' '-' CTE ')' ')'

  93  argumento_id_lambda : identificador

  94  cabecera_funcion : identificador '('

  95  argumentos_funcion : listapinvocacion

  96  listapinvocacion : listapinvocacion ',' pinvocacion
  97                   | pinvocacion

  98  pinvocacion : expresion FLECHA ID
  99              | cabecera_declaracion_lambda '{' listasentenciasejecutables '}' FLECHA ID
 100              | cabecera_declaracion_lambda '{' listasentenciasejecutables FLECHA ID
 101              | cabecera_declaracion_lambda listasentenciasejecutables '}' FLECHA ID
 102              | cabecera_declaracion_lambda listasentenciasejecutables FLECHA ID
 103              | cabecera_declaracion_lambda '{' listasentenciasejecutables '}' FLECHA
 104              | expresion FLECHA

 105  cabecera_declaracion_lambda : '(' tipo ID ')'

 106  expresion : expresion '+' termino
 107            | expresion '-' termino
 108            | error '+' termino
 109            | expresion '+' error
 110            | error '-' termino
 111            | expresion '-' error
 112            | termino

