   0  $accept : prog $end

   1  $$1 :

   2  $$2 :

   3  prog : ID $$1 bloque_sentencias $$2 EOF
   4       | bloque_sentencias EOF

   5  bloque_sentencias : '{' listasentencias '}'
   6                    | '{' '}'
   7                    | '{' listasentencias
   8                    | listasentencias '}'
   9                    | listasentencias

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion

  16  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  17                             | sentenciaejecutable ';'
  18                             | listasentenciasejecutables sentenciaejecutable
  19                             | sentenciaejecutable

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | funcion
  23                      | print
  24                      | funcion_lambda
  25                      | sentencia_return

  26  declaracion : tipo listaIDs

  27  $$3 :

  28  $$4 :

  29  $$5 :

  30  declaracion : tipo ID $$3 '(' listaparametros $$4 ')' $$5 '{' listasentencias '}'

  31  sentencia_return : RETURN '(' expresion ')'
  32                   | RETURN '(' ')'

  33  asignacion : identificador ASIG expresion
  34             | listavariables '=' listaconstantes

  35  bloque_control_estructura : '{' listasentenciasejecutables '}'
  36                            | sentenciaejecutable ';'
  37                            | '{' '}'

  38  $$6 :

  39  bloque_control : $$6 bloque_control_estructura

  40  inicio_do : DO

  41  $$7 :

  42  bloque_control_else : $$7 bloque_control

  43  control : IF condicion bloque_control ELSE bloque_control_else ENDIF
  44          | IF condicion bloque_control ENDIF

  45  $$8 :

  46  control : inicio_do bloque_control UNTIL condicion $$8
  47          | IF condicion bloque_control ELSE bloque_control_else
  48          | IF condicion bloque_control
  49          | IF condicion bloque_control ELSE ENDIF
  50          | IF condicion ELSE bloque_control_else ENDIF
  51          | IF condicion ENDIF
  52          | IF condicion ELSE ENDIF
  53          | DO UNTIL condicion

  54  $$9 :

  55  control : inicio_do bloque_control condicion $$9

  56  print : PRINT '(' expresion ')'
  57        | PRINT '(' CADENAML ')'
  58        | PRINT '(' ')'

  59  condicion : '(' cuerpocondicion ')'
  60            | cuerpocondicion ')'
  61            | '(' cuerpocondicion
  62            | cuerpocondicion

  63  cuerpocondicion : expresion comparador expresion
  64                  | expresion

  65  comparador : '>'
  66             | '<'
  67             | MAYORIG
  68             | MENORIG
  69             | IGUAL
  70             | DISTINTO

  71  tipo : LONG
  72       | LAMBDA

  73  listaIDs : listaIDs ',' ID
  74           | ID

  75  listavariables : listavariables ',' identificador
  76                 | identificador

  77  identificador : ID
  78                | identificador '.' ID

  79  listaparametros : listaparametros ',' parametro
  80                  | parametro

  81  parametro : CV tipo ID
  82            | tipo ID
  83            | CV tipo
  84            | tipo
  85            | CV ID
  86            | ID

  87  $$10 :

  88  funcion : cabecera_funcion argumentos_funcion ')' $$10

  89  $$11 :

  90  funcion_lambda : cabecera_funcion identificador ')' $$11

  91  $$12 :

  92  funcion_lambda : cabecera_funcion CTE ')' $$12

  93  $$13 :

  94  funcion_lambda : cabecera_funcion '-' CTE ')' $$13

  95  $$14 :

  96  funcion_lambda : cabecera_funcion TRUNC '(' CTE ')' ')' $$14

  97  $$15 :

  98  funcion_lambda : cabecera_funcion TRUNC '(' '-' CTE ')' ')' $$15

  99  cabecera_funcion : ID '('

 100  argumentos_funcion : listapinvocacion

 101  listapinvocacion : listapinvocacion ',' pinvocacion
 102                   | pinvocacion

 103  pinvocacion : expresion FLECHA ID
 104              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
 105              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
 106              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
 107              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
 108              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
 109              | expresion FLECHA

 110  expresion : expresion '+' termino
 111            | expresion '-' termino
 112            | error '+' termino
 113            | expresion '+' error
 114            | error '-' termino
 115            | expresion '-' error
 116            | termino

 117  termino : termino '*' factor
 118          | termino '/' factor
 119          | error '*' factor
 120          | termino '*' error
 121          | error '/' factor
 122          | termino '/' error
 123          | termino error factor
 124          | factor

 125  factor : CTE
 126         | '-' CTE
 127         | identificador
 128         | funcion
 129         | TRUNC '(' CTE ')'
 130         | TRUNC '(' '-' CTE ')'

 131  listaconstantes : listaconstantes ',' CTE
 132                  | listaconstantes ',' '-' CTE
 133                  | CTE
 134                  | '-' CTE
 135                  | listaconstantes CTE
 136                  | listaconstantes '-' CTE

