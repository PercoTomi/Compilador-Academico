   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | ID '{' '}' EOF
   3       | '{' listasentencias '}' EOF
   4       | ID '{' listasentencias EOF
   5       | ID listasentencias '}' EOF
   6       | ID listasentencias EOF
   7       | '{' listasentencias EOF
   8       | listasentencias '}' EOF
   9       | listasentencias EOF
  10       | ID '{' error ';' listasentencias '}' EOF

  11  listasentencias : listasentencias sentencia
  12                  | sentencia

  13  sentencia : sentenciaejecutable ';'
  14            | declaracion ';'
  15            | sentenciaejecutable
  16            | declaracion

  17  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  18                             | sentenciaejecutable ';'
  19                             | listasentenciasejecutables sentenciaejecutable
  20                             | sentenciaejecutable

  21  sentenciaejecutable : asignacion
  22                      | control
  23                      | funcion
  24                      | print
  25                      | funcion_lambda
  26                      | sentencia_return

  27  declaracion : tipo listavariables

  28  $$1 :

  29  declaracion : tipo ID '(' listaparametros ')' $$1 '{' listasentencias '}'

  30  sentencia_return : RETURN '(' expresion ')'
  31                   | RETURN '(' ')'

  32  asignacion : identificador ASIG expresion
  33             | listavariables '=' listaconstantes

  34  bloque_control_estructura : '{' listasentenciasejecutables '}'
  35                            | sentenciaejecutable ';'
  36                            | '{' '}'

  37  $$2 :

  38  bloque_control : $$2 bloque_control_estructura

  39  inicio_do : DO

  40  $$3 :

  41  bloque_control_else : $$3 bloque_control

  42  control : IF condicion bloque_control ELSE bloque_control_else ENDIF
  43          | IF condicion bloque_control ENDIF

  44  $$4 :

  45  control : inicio_do bloque_control UNTIL condicion $$4
  46          | IF condicion bloque_control ELSE bloque_control_else
  47          | IF condicion bloque_control
  48          | IF condicion bloque_control ELSE ENDIF
  49          | IF condicion ELSE bloque_control_else ENDIF
  50          | IF condicion ENDIF
  51          | IF condicion ELSE ENDIF
  52          | DO UNTIL condicion

  53  $$5 :

  54  control : inicio_do bloque_control condicion $$5

  55  print : PRINT '(' expresion ')'
  56        | PRINT '(' CADENAML ')'
  57        | PRINT '(' ')'

  58  condicion : '(' cuerpocondicion ')'
  59            | cuerpocondicion ')'
  60            | '(' cuerpocondicion
  61            | cuerpocondicion

  62  cuerpocondicion : expresion comparador expresion
  63                  | expresion

  64  comparador : '>'
  65             | '<'
  66             | MAYORIG
  67             | MENORIG
  68             | IGUAL
  69             | DISTINTO

  70  tipo : LONG
  71       | LAMBDA

  72  listavariables : listavariables ',' identificador
  73                 | identificador

  74  identificador : ID
  75                | identificador '.' ID

  76  funcion : ID '(' argumentos_funcion ')'

  77  funcion_lambda : ID '(' identificador ')'
  78                 | ID '(' CTE ')'
  79                 | ID '(' '-' CTE ')'

  80  argumentos_funcion : listapinvocacion

  81  listapinvocacion : listapinvocacion ',' pinvocacion
  82                   | pinvocacion

  83  pinvocacion : expresion FLECHA ID
  84              | TRUNC '(' expresion ')' FLECHA ID
  85              | TRUNC '(' expresion FLECHA ID
  86              | TRUNC expresion ')' FLECHA ID
  87              | TRUNC expresion FLECHA ID
  88              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
  89              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
  90              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
  91              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
  92              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
  93              | expresion FLECHA
  94              | TRUNC '(' expresion ')' FLECHA

  95  listaparametros : listaparametros ',' parametro
  96                  | parametro

  97  parametro : CV tipo ID
  98            | tipo ID
  99            | CV tipo
 100            | tipo
 101            | CV ID
 102            | ID

 103  expresion : expresion '+' termino
 104            | expresion '-' termino
 105            | error '+' termino
 106            | expresion '+' error
 107            | error '-' termino
 108            | expresion '-' error
 109            | termino

 110  termino : termino '*' factor
 111          | termino '/' factor
 112          | error '*' factor
 113          | termino '*' error
 114          | error '/' factor
 115          | termino '/' error
 116          | termino error factor
 117          | factor

 118  factor : CTE
 119         | '-' CTE
 120         | identificador
 121         | funcion

 122  listaconstantes : listaconstantes ',' CTE
 123                  | listaconstantes ',' '-' CTE
 124                  | CTE
 125                  | '-' CTE
 126                  | listaconstantes CTE
 127                  | listaconstantes '-' CTE

