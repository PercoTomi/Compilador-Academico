   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | '{' listasentencias '}' EOF
   3       | ID '{' listasentencias EOF
   4       | ID listasentencias '}' EOF
   5       | ID listasentencias EOF
   6       | '{' listasentencias EOF
   7       | listasentencias '}' EOF
   8       | listasentencias EOF
   9       | error

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion

  16  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  17                             | sentenciaejecutable ';'
  18                             | listasentenciasejecutables sentenciaejecutable
  19                             | sentenciaejecutable

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | funcion
  23                      | print

  24  declaracion : tipo listavariables
  25              | tipo ID '(' listaparametros ')' '{' listasentencias RETURN '(' expresion ')' ';' '}'

  26  asignacion : identificador ASIG expresion
  27             | listavariables '=' listaconstantes

  28  cuerpo_bloque : '{' listasentenciasejecutables '}'
  29                | sentenciaejecutable ';'
  30                | '{' '}'

  31  control : IF condicion cuerpo_bloque ELSE cuerpo_bloque ENDIF
  32          | IF condicion cuerpo_bloque ENDIF
  33          | DO cuerpo_bloque UNTIL condicion
  34          | IF condicion cuerpo_bloque ELSE cuerpo_bloque
  35          | IF condicion cuerpo_bloque
  36          | IF condicion cuerpo_bloque ELSE ENDIF
  37          | IF condicion ELSE cuerpo_bloque ENDIF
  38          | IF condicion ENDIF
  39          | IF condicion ELSE ENDIF
  40          | DO UNTIL condicion
  41          | DO cuerpo_bloque condicion

  42  print : PRINT '(' expresion ')'
  43        | PRINT '(' CADENAML ')'
  44        | PRINT '(' ')'

  45  condicion : '(' cuerpocondicion ')'
  46            | cuerpocondicion ')'
  47            | '(' cuerpocondicion
  48            | cuerpocondicion

  49  cuerpocondicion : expresion comparador expresion
  50                  | expresion

  51  comparador : '>'
  52             | '<'
  53             | MAYORIG
  54             | MENORIG
  55             | IGUAL
  56             | DISTINTO

  57  tipo : LONG
  58       | LAMBDA

  59  listavariables : listavariables ',' identificador
  60                 | identificador
  61                 | listavariables error identificador

  62  identificador : ID
  63                | identificador '.' ID

  64  funcion : ID '(' argumentos_funcion ')'

  65  argumentos_funcion : listapinvocacion
  66                     | identificador
  67                     | CTE
  68                     | '-' CTE

  69  listapinvocacion : listapinvocacion ',' pinvocacion
  70                   | pinvocacion

  71  pinvocacion : expresion FLECHA ID
  72              | TRUNC '(' expresion ')' FLECHA ID
  73              | TRUNC '(' expresion FLECHA ID
  74              | TRUNC expresion ')' FLECHA ID
  75              | TRUNC expresion FLECHA ID
  76              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
  77              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
  78              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
  79              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
  80              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
  81              | expresion FLECHA
  82              | TRUNC '(' expresion ')' FLECHA

  83  listaparametros : listaparametros ',' parametro
  84                  | parametro

  85  parametro : CV tipo ID
  86            | tipo ID
  87            | CV tipo
  88            | tipo
  89            | CV ID
  90            | ID

  91  expresion : expresion '+' termino
  92            | expresion '-' termino
  93            | error '+' termino
  94            | expresion '+' error
  95            | error '-' termino
  96            | expresion '-' error
  97            | termino

  98  termino : termino '*' factor
  99          | termino '/' factor
 100          | error '*' factor
 101          | termino '*' error
 102          | error '/' factor
 103          | termino '/' error
 104          | termino error factor
 105          | factor

 106  factor : CTE
 107         | '-' CTE
 108         | identificador
 109         | funcion

 110  listaconstantes : listaconstantes ',' CTE
 111                  | listaconstantes ',' '-' CTE
 112                  | CTE
 113                  | '-' CTE
 114                  | listaconstantes CTE
 115                  | listaconstantes '-' CTE

