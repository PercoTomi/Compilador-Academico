   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}'
   2       | '{' listasentencias '}'
   3       | ID '{' listasentencias
   4       | ID listasentencias '}'
   5       | ID '{' listasentencias error '}'
   6       | ID '{' error '}'
   7       | ID '{' listasentencias error
   8       | ID '{' error

   9  listasentencias : listasentencias sentencia
  10                  | sentencia
  11                  | listasentencias error ';'
  12                  | error ';'

  13  sentencia : sentenciaejecutable ';'
  14            | declaracion ';'

  15  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  16                             | sentenciaejecutable ';'

  17  sentenciaejecutable : asignacion
  18                      | control
  19                      | print
  20                      | funcion

  21  declaracion : tipo listavariables
  22              | tipo ID '(' listaparametros ')' '{' listasentencias RETURN '(' expresion ')' ';' '}'

  23  asignacion : identificador ASIG expresion
  24             | listavariables '=' listaconstantes

  25  listaconstantes : listaconstantes ',' CTE
  26                  | CTE
  27                  | listaconstantes CTE

  28  cuerpo_control : '{' listasentenciasejecutables '}'
  29                 | '{' '}'

  30  control : IF condicion cuerpo_control ELSE cuerpo_control ENDIF
  31          | IF condicion cuerpo_control ENDIF
  32          | DO cuerpo_control UNTIL condicion
  33          | IF condicion cuerpo_control ELSE cuerpo_control
  34          | IF condicion cuerpo_control
  35          | IF condicion cuerpo_control ELSE ENDIF
  36          | IF condicion ELSE cuerpo_control ENDIF
  37          | IF condicion ENDIF
  38          | IF condicion ELSE ENDIF
  39          | DO UNTIL condicion
  40          | DO cuerpo_control condicion

  41  print : PRINT '(' expresion ')'
  42        | PRINT '(' CADENAML ')'
  43        | PRINT '(' ')'

  44  condicion : '(' cuerpocondicion ')'
  45            | cuerpocondicion ')'
  46            | '(' cuerpocondicion
  47            | cuerpocondicion

  48  cuerpocondicion : expresion comparador expresion
  49                  | expresion expresion

  50  comparador : '>'
  51             | '<'
  52             | MAYORIG
  53             | MENORIG
  54             | IGUAL
  55             | DISTINTO

  56  tipo : LONG
  57       | LAMBDA

  58  identificador : ID
  59                | identificador '.' ID

  60  listavariables : listavariables ',' identificador
  61                 | identificador
  62                 | listavariables ID
  63                 | listavariables identificador '.' ID

  64  listaparametros : listaparametros ',' parametro
  65                  | parametro

  66  parametro : CV tipo ID
  67            | tipo ID
  68            | CV tipo
  69            | tipo
  70            | CV ID
  71            | ID

  72  expresion : expresion '+' termino
  73            | expresion '-' termino
  74            | termino
  75            | expresion '+' error
  76            | expresion '-' error
  77            | error '+' termino
  78            | error '-' termino
  79            | expresion error termino

  80  termino : termino '*' factor
  81          | termino '/' factor
  82          | factor
  83          | termino '*' error
  84          | termino '/' error
  85          | error '*' factor
  86          | error '/' factor

  87  factor : identificador
  88         | CTE
  89         | funcion

  90  funcion : ID '(' listapinvocacion ')'
  91          | ID '(' identificador ')'
  92          | ID '(' CTE ')'
  93          | error '(' listapinvocacion ')'
  94          | error '(' identificador ')'
  95          | error '(' CTE ')'

  96  listapinvocacion : listapinvocacion ',' pinvocacion
  97                   | pinvocacion

  98  pinvocacion : expresion FLECHA ID
  99              | TRUNC '(' expresion ')' FLECHA ID
 100              | TRUNC '(' expresion FLECHA ID
 101              | TRUNC expresion ')' FLECHA ID
 102              | TRUNC expresion FLECHA ID
