   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | ID '{' '}' EOF
   3       | '{' listasentencias '}' EOF
   4       | ID '{' listasentencias EOF
   5       | ID listasentencias '}' EOF
   6       | ID listasentencias EOF
   7       | '{' listasentencias EOF
   8       | listasentencias '}' EOF
   9       | listasentencias EOF
  10       | ID '{' error ';' listasentencias '}' EOF

  11  listasentencias : listasentencias sentencia
  12                  | sentencia

  13  sentencia : sentenciaejecutable ';'
  14            | declaracion ';'
  15            | sentenciaejecutable
  16            | declaracion

  17  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  18                             | sentenciaejecutable ';'
  19                             | listasentenciasejecutables sentenciaejecutable
  20                             | sentenciaejecutable

  21  sentenciaejecutable : asignacion
  22                      | control
  23                      | funcion
  24                      | print
  25                      | funcion_lambda
  26                      | sentencia_return

  27  declaracion : tipo listavariables

  28  $$1 :

  29  declaracion : tipo ID '(' listaparametros ')' $$1 '{' listasentencias '}'

  30  sentencia_return : RETURN '(' expresion ')'
  31                   | RETURN '(' ')'

  32  asignacion : identificador ASIG expresion
  33             | listavariables '=' listaconstantes

  34  bloque_control_estructura : '{' listasentenciasejecutables '}'
  35                            | sentenciaejecutable ';'
  36                            | '{' '}'

  37  $$2 :

  38  bloque_control : $$2 bloque_control_estructura

  39  inicio_do : DO

  40  $$3 :

  41  bloque_control_else : $$3 bloque_control

  42  control : IF condicion bloque_control ELSE bloque_control_else ENDIF
  43          | IF condicion bloque_control ENDIF

  44  $$4 :

  45  control : inicio_do bloque_control UNTIL condicion $$4
  46          | IF condicion bloque_control ELSE bloque_control_else
  47          | IF condicion bloque_control
  48          | IF condicion bloque_control ELSE ENDIF
  49          | IF condicion ELSE bloque_control_else ENDIF
  50          | IF condicion ENDIF
  51          | IF condicion ELSE ENDIF
  52          | DO UNTIL condicion

  53  $$5 :

  54  control : inicio_do bloque_control condicion $$5

  55  print : PRINT '(' expresion ')'
  56        | PRINT '(' CADENAML ')'
  57        | PRINT '(' ')'

  58  condicion : '(' cuerpocondicion ')'
  59            | cuerpocondicion ')'
  60            | '(' cuerpocondicion
  61            | cuerpocondicion

  62  cuerpocondicion : expresion comparador expresion
  63                  | expresion

  64  comparador : '>'
  65             | '<'
  66             | MAYORIG
  67             | MENORIG
  68             | IGUAL
  69             | DISTINTO

  70  tipo : LONG
  71       | LAMBDA

  72  listavariables : listavariables ',' identificador
  73                 | identificador

  74  identificador : ID
  75                | identificador '.' ID

  76  listaparametros : listaparametros ',' parametro
  77                  | parametro

  78  parametro : CV tipo ID
  79            | tipo ID
  80            | CV tipo
  81            | tipo
  82            | CV ID
  83            | ID

  84  $$6 :

  85  funcion : cabecera_funcion argumentos_funcion ')' $$6

  86  $$7 :

  87  funcion_lambda : cabecera_funcion identificador ')' $$7

  88  $$8 :

  89  funcion_lambda : cabecera_funcion CTE ')' $$8

  90  $$9 :

  91  funcion_lambda : cabecera_funcion '-' CTE ')' $$9

  92  $$10 :

  93  funcion_lambda : cabecera_funcion TRUNC '(' CTE ')' ')' $$10

  94  $$11 :

  95  funcion_lambda : cabecera_funcion TRUNC '(' '-' CTE ')' ')' $$11

  96  cabecera_funcion : ID '('

  97  argumentos_funcion : listapinvocacion

  98  listapinvocacion : listapinvocacion ',' pinvocacion
  99                   | pinvocacion

 100  pinvocacion : expresion FLECHA ID
 101              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
 102              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
 103              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
 104              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
 105              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
 106              | expresion FLECHA

 107  expresion : expresion '+' termino
 108            | expresion '-' termino
 109            | error '+' termino
 110            | expresion '+' error
 111            | error '-' termino
 112            | expresion '-' error
 113            | termino

 114  termino : termino '*' factor
 115          | termino '/' factor
 116          | error '*' factor
 117          | termino '*' error
 118          | error '/' factor
 119          | termino '/' error
 120          | termino error factor
 121          | factor

 122  factor : CTE
 123         | '-' CTE
 124         | identificador
 125         | funcion
 126         | TRUNC '(' CTE ')'
 127         | TRUNC '(' '-' CTE ')'

 128  listaconstantes : listaconstantes ',' CTE
 129                  | listaconstantes ',' '-' CTE
 130                  | CTE
 131                  | '-' CTE
 132                  | listaconstantes CTE
 133                  | listaconstantes '-' CTE

