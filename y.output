   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | '{' listasentencias '}' EOF
   3       | ID '{' listasentencias EOF
   4       | ID listasentencias '}' EOF
   5       | ID listasentencias EOF

   6  $$1 :

   7  prog : ID '{' listasentencias error EOF $$1 '}'

   8  $$2 :

   9  prog : ID '{' error EOF $$2 '}'
  10       | ID '{' listasentencias error '}' EOF
  11       | ID '{' error '}' EOF

  12  listasentencias : listasentencias sentencia
  13                  | sentencia
  14                  | listasentencias error ';'
  15                  | error ';'

  16  sentencia : sentenciaejecutable ';'
  17            | declaracion ';'

  18  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  19                             | sentenciaejecutable ';'

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | print
  23                      | funcion

  24  declaracion : tipo listavariables
  25              | tipo ID '(' listaparametros ')' '{' listasentencias RETURN '(' expresion ')' ';' '}'

  26  asignacion : identificador ASIG expresion
  27             | listavariables '=' listaconstantes

  28  listaconstantes : listaconstantes ',' CTE
  29                  | CTE
  30                  | listaconstantes CTE

  31  cuerpo_control : '{' listasentenciasejecutables '}'
  32                 | '{' '}'

  33  control : IF condicion cuerpo_control ELSE cuerpo_control ENDIF
  34          | IF condicion cuerpo_control ENDIF
  35          | DO cuerpo_control UNTIL condicion
  36          | IF condicion cuerpo_control ELSE cuerpo_control
  37          | IF condicion cuerpo_control
  38          | IF condicion cuerpo_control ELSE ENDIF
  39          | IF condicion ELSE cuerpo_control ENDIF
  40          | IF condicion ENDIF
  41          | IF condicion ELSE ENDIF
  42          | DO UNTIL condicion
  43          | DO cuerpo_control condicion

  44  print : PRINT '(' expresion ')'
  45        | PRINT '(' CADENAML ')'
  46        | PRINT '(' ')'

  47  condicion : '(' cuerpocondicion ')'
  48            | cuerpocondicion ')'
  49            | '(' cuerpocondicion
  50            | cuerpocondicion

  51  cuerpocondicion : expresion comparador expresion
  52                  | expresion expresion

  53  comparador : '>'
  54             | '<'
  55             | MAYORIG
  56             | MENORIG
  57             | IGUAL
  58             | DISTINTO

  59  tipo : LONG
  60       | LAMBDA

  61  identificador : ID
  62                | identificador '.' ID

  63  listavariables : listavariables ',' identificador
  64                 | identificador
  65                 | listavariables ID
  66                 | listavariables identificador '.' ID

  67  listaparametros : listaparametros ',' parametro
  68                  | parametro

  69  parametro : CV tipo ID
  70            | tipo ID
  71            | CV tipo
  72            | tipo
  73            | CV ID
  74            | ID

  75  expresion : expresion '+' termino
  76            | expresion '-' termino
  77            | termino
  78            | expresion '+' error
  79            | expresion '-' error
  80            | error '+' termino
  81            | error '-' termino
  82            | expresion error termino

  83  termino : termino '*' factor
  84          | termino '/' factor
  85          | factor
  86          | termino '*' error
  87          | termino '/' error
  88          | error '*' factor
  89          | error '/' factor

  90  factor : identificador
  91         | CTE
  92         | funcion

  93  funcion : ID '(' listapinvocacion ')'
  94          | ID '(' identificador ')'
  95          | ID '(' CTE ')'
  96          | error '(' listapinvocacion ')'
  97          | error '(' identificador ')'
  98          | error '(' CTE ')'

  99  listapinvocacion : listapinvocacion ',' pinvocacion
 100                   | pinvocacion

 101  pinvocacion : expresion FLECHA ID
 102              | TRUNC '(' expresion ')' FLECHA ID
 103              | TRUNC '(' expresion FLECHA ID
 104              | TRUNC expresion ')' FLECHA ID
