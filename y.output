   0  $accept : prog $end

   1  prog : ID '{' bloque_programa '}' EOF
   2       | ID '{' '}' EOF
   3       | '{' bloque_programa '}' EOF
   4       | ID '{' bloque_programa EOF
   5       | ID bloque_programa '}' EOF
   6       | ID bloque_programa EOF
   7       | '{' bloque_programa EOF
   8       | bloque_programa '}' EOF
   9       | bloque_programa EOF
  10       | ID '{' error ';' bloque_programa '}' EOF

  11  bloque_programa : listasentencias
  12                  | listasentencias_conLambda
  13                  | listasentencias listasentencias_conLambda

  14  listasentencias : listasentencias sentencia
  15                  | sentencia

  16  sentencia : sentenciaejecutable ';'
  17            | declaracion ';'
  18            | sentenciaejecutable
  19            | declaracion

  20  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  21                             | sentenciaejecutable ';'
  22                             | listasentenciasejecutables sentenciaejecutable
  23                             | sentenciaejecutable

  24  sentenciaejecutable : asignacion
  25                      | control
  26                      | funcion
  27                      | print

  28  listasentencias_conLambda : listasentencias_conLambda sentencia
  29                            | listasentencias_conLambda funcion_lambda ';'
  30                            | funcion_lambda ';'

  31  declaracion : tipo listavariables
  32              | tipo ID '(' listaparametros ')' '{' listasentencias RETURN '(' expresion ')' ';' '}'
  33              | tipo ID '(' listaparametros ')' '{' listasentencias_conLambda RETURN '(' expresion ')' ';' '}'
  34              | tipo ID '(' listaparametros ')' '{' listasentencias listasentencias_conLambda RETURN '(' expresion ')' ';' '}'

  35  asignacion : identificador ASIG expresion
  36             | listavariables '=' listaconstantes

  37  cuerpo_bloque : '{' listasentenciasejecutables '}'
  38                | sentenciaejecutable ';'
  39                | '{' '}'
  40                | '{' listasentenciasejecutables listasentencias_conLambda '}'
  41                | '{' listasentencias_conLambda '}'

  42  control : IF condicion cuerpo_bloque ELSE cuerpo_bloque ENDIF
  43          | IF condicion cuerpo_bloque ENDIF
  44          | DO cuerpo_bloque UNTIL condicion
  45          | IF condicion cuerpo_bloque ELSE cuerpo_bloque
  46          | IF condicion cuerpo_bloque
  47          | IF condicion cuerpo_bloque ELSE ENDIF
  48          | IF condicion ELSE cuerpo_bloque ENDIF
  49          | IF condicion ENDIF
  50          | IF condicion ELSE ENDIF
  51          | DO UNTIL condicion
  52          | DO cuerpo_bloque condicion

  53  print : PRINT '(' expresion ')'
  54        | PRINT '(' CADENAML ')'
  55        | PRINT '(' ')'

  56  condicion : '(' cuerpocondicion ')'
  57            | cuerpocondicion ')'
  58            | '(' cuerpocondicion
  59            | cuerpocondicion

  60  cuerpocondicion : expresion comparador expresion
  61                  | expresion

  62  comparador : '>'
  63             | '<'
  64             | MAYORIG
  65             | MENORIG
  66             | IGUAL
  67             | DISTINTO

  68  tipo : LONG
  69       | LAMBDA

  70  listavariables : listavariables ',' identificador
  71                 | identificador

  72  identificador : ID
  73                | identificador '.' ID

  74  funcion : ID '(' argumentos_funcion ')'

  75  funcion_lambda : ID '(' identificador ')'
  76                 | ID '(' CTE ')'
  77                 | ID '(' '-' CTE ')'

  78  argumentos_funcion : listapinvocacion

  79  listapinvocacion : listapinvocacion ',' pinvocacion
  80                   | pinvocacion

  81  pinvocacion : expresion FLECHA ID
  82              | TRUNC '(' expresion ')' FLECHA ID
  83              | TRUNC '(' expresion FLECHA ID
  84              | TRUNC expresion ')' FLECHA ID
  85              | TRUNC expresion FLECHA ID
  86              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
  87              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
  88              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
  89              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
  90              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
  91              | expresion FLECHA
  92              | TRUNC '(' expresion ')' FLECHA

  93  listaparametros : listaparametros ',' parametro
  94                  | parametro

  95  parametro : CV tipo ID
  96            | tipo ID
  97            | CV tipo
  98            | tipo
  99            | CV ID
 100            | ID

 101  expresion : expresion '+' termino
 102            | expresion '-' termino
 103            | error '+' termino
 104            | expresion '+' error
 105            | error '-' termino
 106            | expresion '-' error
 107            | termino

 108  termino : termino '*' factor
 109          | termino '/' factor
 110          | error '*' factor
 111          | termino '*' error
 112          | error '/' factor
 113          | termino '/' error
 114          | termino error factor
 115          | factor

 116  factor : CTE
 117         | '-' CTE
 118         | identificador
 119         | funcion

 120  listaconstantes : listaconstantes ',' CTE
 121                  | listaconstantes ',' '-' CTE
 122                  | CTE
 123                  | '-' CTE
 124                  | listaconstantes CTE
 125                  | listaconstantes '-' CTE

