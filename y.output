   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | ID '{' '}' EOF
   3       | '{' listasentencias '}' EOF
   4       | ID '{' listasentencias EOF
   5       | ID listasentencias '}' EOF
   6       | ID listasentencias EOF
   7       | '{' listasentencias EOF
   8       | listasentencias '}' EOF
   9       | listasentencias EOF
  10       | ID '{' error ';' listasentencias '}' EOF

  11  listasentencias : listasentencias sentencia
  12                  | sentencia

  13  sentencia : sentenciaejecutable ';'
  14            | declaracion ';'
  15            | sentenciaejecutable
  16            | declaracion

  17  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  18                             | sentenciaejecutable ';'
  19                             | listasentenciasejecutables sentenciaejecutable
  20                             | sentenciaejecutable

  21  sentenciaejecutable : asignacion
  22                      | control
  23                      | funcion
  24                      | print
  25                      | funcion_lambda

  26  declaracion : tipo listavariables

  27  $$1 :

  28  declaracion : tipo ID '(' listaparametros ')' $$1 '{' listasentencias RETURN '(' expresion ')' ';' '}'

  29  asignacion : identificador ASIG expresion
  30             | listavariables '=' listaconstantes

  31  cuerpo_bloque : '{' listasentenciasejecutables '}'
  32                | sentenciaejecutable ';'
  33                | '{' '}'

  34  control : IF condicion cuerpo_bloque ELSE cuerpo_bloque ENDIF
  35          | IF condicion cuerpo_bloque ENDIF
  36          | DO cuerpo_bloque UNTIL condicion
  37          | IF condicion cuerpo_bloque ELSE cuerpo_bloque
  38          | IF condicion cuerpo_bloque
  39          | IF condicion cuerpo_bloque ELSE ENDIF
  40          | IF condicion ELSE cuerpo_bloque ENDIF
  41          | IF condicion ENDIF
  42          | IF condicion ELSE ENDIF
  43          | DO UNTIL condicion
  44          | DO cuerpo_bloque condicion

  45  print : PRINT '(' expresion ')'
  46        | PRINT '(' CADENAML ')'
  47        | PRINT '(' ')'

  48  condicion : '(' cuerpocondicion ')'
  49            | cuerpocondicion ')'
  50            | '(' cuerpocondicion
  51            | cuerpocondicion

  52  cuerpocondicion : expresion comparador expresion
  53                  | expresion

  54  comparador : '>'
  55             | '<'
  56             | MAYORIG
  57             | MENORIG
  58             | IGUAL
  59             | DISTINTO

  60  tipo : LONG
  61       | LAMBDA

  62  listavariables : listavariables ',' identificador
  63                 | identificador

  64  identificador : ID
  65                | identificador '.' ID

  66  funcion : ID '(' argumentos_funcion ')'

  67  funcion_lambda : ID '(' identificador ')'
  68                 | ID '(' CTE ')'
  69                 | ID '(' '-' CTE ')'

  70  argumentos_funcion : listapinvocacion

  71  listapinvocacion : listapinvocacion ',' pinvocacion
  72                   | pinvocacion

  73  pinvocacion : expresion FLECHA ID
  74              | TRUNC '(' expresion ')' FLECHA ID
  75              | TRUNC '(' expresion FLECHA ID
  76              | TRUNC expresion ')' FLECHA ID
  77              | TRUNC expresion FLECHA ID
  78              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
  79              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
  80              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
  81              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
  82              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
  83              | expresion FLECHA
  84              | TRUNC '(' expresion ')' FLECHA

  85  listaparametros : listaparametros ',' parametro
  86                  | parametro

  87  parametro : CV tipo ID
  88            | tipo ID
  89            | CV tipo
  90            | tipo
  91            | CV ID
  92            | ID

  93  expresion : expresion '+' termino
  94            | expresion '-' termino
  95            | error '+' termino
  96            | expresion '+' error
  97            | error '-' termino
  98            | expresion '-' error
  99            | termino

 100  termino : termino '*' factor
 101          | termino '/' factor
 102          | error '*' factor
 103          | termino '*' error
 104          | error '/' factor
 105          | termino '/' error
 106          | termino error factor
 107          | factor

 108  factor : CTE
 109         | '-' CTE
 110         | identificador
 111         | funcion

 112  listaconstantes : listaconstantes ',' CTE
 113                  | listaconstantes ',' '-' CTE
 114                  | CTE
 115                  | '-' CTE
 116                  | listaconstantes CTE
 117                  | listaconstantes '-' CTE

