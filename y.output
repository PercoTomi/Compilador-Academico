   0  $accept : prog $end

   1  prog : ID '{' listasentencia '}'

   2  listasentencia : listasentencia sentencia ';'
   3                 | sentencia ';'

   4  sentencia : asignacion
   5            | declaracion
   6            | control
   7            | print
   8            | funcion

   9  declaracion : tipo listavariables
  10              | tipo ID '(' listaparametros ')' '{' listasentencia RETURN '(' expresion ')' ';' '}'

  11  asignacion : ID ASIG expresion
  12             | ID '.' ID ASIG expresion
  13             | listavariables '=' listaexpresiones

  14  control : IF '(' condicion ')' THEN '{' listasentencia '}' ELSE '{' listasentencia '}' ENDIF
  15          | IF '(' condicion ')' THEN '{' listasentencia '}' ENDIF
  16          | DO '{' listasentencia '}' UNTIL '(' condicion ')'

  17  print : PRINT '(' expresion ')'
  18        | PRINT '(' CADENAML ')'

  19  condicion : expresion comparador expresion

  20  comparador : '>'
  21             | '<'
  22             | MAYORIG
  23             | MENORIG
  24             | IGUAL
  25             | DISTINTO

  26  tipo : LONG

  27  listavariables : listavariables ',' ID
  28                 | ID

  29  listaparametros : listaparametros ',' parametro
  30                  | parametro

  31  parametro : CV tipo ID
  32            | tipo ID

  33  expresion : expresion '+' termino
  34            | expresion '-' termino
  35            | termino

  36  listaexpresiones : listaexpresiones ',' expresion
  37                   | expresion

  38  termino : termino '*' factor
  39          | termino '/' factor
  40          | factor

  41  factor : ID
  42         | CTE
  43         | funcion

  44  funcion : ID '(' listapinvocacion ')'

  45  listapinvocacion : listapinvocacion ',' pinvocacion
  46                   | pinvocacion

  47  pinvocacion : expresion FLECHA ID
  48              | TRUNC '(' expresion ')' FLECHA ID

