   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | '{' listasentencias '}' EOF
   3       | ID '{' listasentencias EOF
   4       | ID listasentencias '}' EOF
   5       | ID listasentencias EOF
   6       | '{' listasentencias EOF
   7       | listasentencias '}' EOF
   8       | listasentencias EOF

   9  listasentencias : listasentencias sentencia
  10                  | sentencia

  11  sentencia : sentenciaejecutable ';'
  12            | declaracion ';'
  13            | sentenciaejecutable
  14            | declaracion

  15  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  16                             | sentenciaejecutable ';'
  17                             | listasentenciasejecutables sentenciaejecutable
  18                             | sentenciaejecutable

  19  sentenciaejecutable : asignacion
  20                      | control
  21                      | funcion
  22                      | print

  23  declaracion : tipo listavariables
  24              | tipo ID '(' listaparametros ')' '{' listasentencias RETURN '(' expresion ')' ';' '}'

  25  asignacion : identificador ASIG expresion
  26             | listavariables '=' listaconstantes

  27  cuerpo_bloque : '{' listasentenciasejecutables '}'
  28                | sentenciaejecutable ';'
  29                | '{' '}'

  30  control : IF condicion cuerpo_bloque ELSE cuerpo_bloque ENDIF
  31          | IF condicion cuerpo_bloque ENDIF
  32          | DO cuerpo_bloque UNTIL condicion
  33          | IF condicion cuerpo_bloque ELSE cuerpo_bloque
  34          | IF condicion cuerpo_bloque
  35          | IF condicion cuerpo_bloque ELSE ENDIF
  36          | IF condicion ELSE cuerpo_bloque ENDIF
  37          | IF condicion ENDIF
  38          | IF condicion ELSE ENDIF
  39          | DO UNTIL condicion
  40          | DO cuerpo_bloque condicion

  41  print : PRINT '(' expresion ')'
  42        | PRINT '(' CADENAML ')'
  43        | PRINT '(' ')'

  44  condicion : '(' cuerpocondicion ')'
  45            | cuerpocondicion ')'
  46            | '(' cuerpocondicion
  47            | cuerpocondicion

  48  cuerpocondicion : expresion comparador expresion
  49                  | expresion

  50  comparador : '>'
  51             | '<'
  52             | MAYORIG
  53             | MENORIG
  54             | IGUAL
  55             | DISTINTO

  56  tipo : LONG
  57       | LAMBDA

  58  listavariables : listavariables ',' identificador
  59                 | identificador
  60                 | listavariables error identificador

  61  identificador : ID
  62                | identificador '.' ID

  63  funcion : ID '(' argumentos_funcion ')'

  64  argumentos_funcion : listapinvocacion
  65                     | identificador
  66                     | CTE

  67  listapinvocacion : listapinvocacion ',' pinvocacion
  68                   | pinvocacion

  69  pinvocacion : expresion FLECHA ID
  70              | TRUNC '(' expresion ')' FLECHA ID
  71              | TRUNC '(' expresion FLECHA ID
  72              | TRUNC expresion ')' FLECHA ID
  73              | TRUNC expresion FLECHA ID
  74              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
  75              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
  76              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
  77              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
  78              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
  79              | expresion FLECHA
  80              | TRUNC '(' expresion ')' FLECHA

  81  listaparametros : listaparametros ',' parametro
  82                  | parametro

  83  parametro : CV tipo ID
  84            | tipo ID
  85            | CV tipo
  86            | tipo
  87            | CV ID
  88            | ID

  89  expresion : expresion '+' termino
  90            | expresion '-' termino
  91            | error '+' termino
  92            | expresion '+' error
  93            | error '-' termino
  94            | expresion '-' error
  95            | termino

  96  termino : termino '*' factor
  97          | termino '/' factor
  98          | error '*' factor
  99          | termino '*' error
 100          | error '/' factor
 101          | termino '/' error
 102          | termino error factor
 103          | factor

 104  factor : CTE
 105         | '-' CTE
 106         | identificador
 107         | funcion

 108  listaconstantes : listaconstantes ',' CTE
 109                  | listaconstantes ',' '-' CTE
 110                  | CTE
 111                  | '-' CTE
 112                  | listaconstantes CTE
 113                  | listaconstantes '-' CTE

