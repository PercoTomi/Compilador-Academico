   0  $accept : prog $end

   1  $$1 :

   2  $$2 :

   3  prog : ID $$1 bloque_sentencias $$2 EOF
   4       | bloque_sentencias EOF

   5  bloque_sentencias : '{' listasentencias '}'
   6                    | '{' '}'
   7                    | '{' listasentencias
   8                    | listasentencias '}'
   9                    | listasentencias

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion

  16  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  17                             | sentenciaejecutable ';'
  18                             | listasentenciasejecutables sentenciaejecutable
  19                             | sentenciaejecutable

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | funcion
  23                      | print
  24                      | funcion_lambda
  25                      | sentencia_return

  26  declaracion : tipo listaIDs

  27  $$3 :

  28  $$4 :

  29  $$5 :

  30  declaracion : tipo id_funcion $$3 '(' listaparametros $$4 ')' $$5 '{' listasentencias '}'

  31  id_funcion : ID

  32  sentencia_return : RETURN '(' expresion ')'
  33                   | RETURN '(' ')'

  34  asignacion : identificador ASIG expresion
  35             | listavariables '=' listaconstantes

  36  bloque_control_estructura : '{' listasentenciasejecutables '}'
  37                            | sentenciaejecutable ';'
  38                            | '{' '}'

  39  $$6 :

  40  bloque_control : $$6 bloque_control_estructura

  41  inicio_do : DO

  42  $$7 :

  43  bloque_control_else : $$7 bloque_control

  44  control : IF condicion bloque_control ELSE bloque_control_else ENDIF
  45          | IF condicion bloque_control ENDIF

  46  $$8 :

  47  control : inicio_do bloque_control UNTIL condicion $$8
  48          | IF condicion bloque_control ELSE bloque_control_else
  49          | IF condicion bloque_control
  50          | IF condicion bloque_control ELSE ENDIF
  51          | IF condicion ELSE bloque_control_else ENDIF
  52          | IF condicion ENDIF
  53          | IF condicion ELSE ENDIF
  54          | DO UNTIL condicion

  55  $$9 :

  56  control : inicio_do bloque_control condicion $$9

  57  print : PRINT '(' expresion ')'
  58        | PRINT '(' CADENAML ')'
  59        | PRINT '(' ')'

  60  condicion : '(' cuerpocondicion ')'
  61            | cuerpocondicion ')'
  62            | '(' cuerpocondicion
  63            | cuerpocondicion

  64  cuerpocondicion : expresion comparador expresion
  65                  | expresion

  66  comparador : '>'
  67             | '<'
  68             | MAYORIG
  69             | MENORIG
  70             | IGUAL
  71             | DISTINTO

  72  tipo : LONG
  73       | LAMBDA

  74  listaIDs : listaIDs ',' ID
  75           | ID

  76  listavariables : listavariables ',' identificador
  77                 | identificador

  78  identificador : ID
  79                | identificador '.' ID

  80  listaparametros : listaparametros ',' parametro
  81                  | parametro

  82  parametro : CV tipo ID
  83            | tipo ID
  84            | CV tipo
  85            | tipo
  86            | CV ID
  87            | ID

  88  $$10 :

  89  funcion : cabecera_funcion argumentos_funcion ')' $$10

  90  $$11 :

  91  funcion_lambda : cabecera_funcion identificador ')' $$11

  92  $$12 :

  93  funcion_lambda : cabecera_funcion CTE ')' $$12

  94  $$13 :

  95  funcion_lambda : cabecera_funcion '-' CTE ')' $$13

  96  $$14 :

  97  funcion_lambda : cabecera_funcion TRUNC '(' CTE ')' ')' $$14

  98  $$15 :

  99  funcion_lambda : cabecera_funcion TRUNC '(' '-' CTE ')' ')' $$15

 100  cabecera_funcion : identificador '('

 101  argumentos_funcion : listapinvocacion

 102  listapinvocacion : listapinvocacion ',' pinvocacion
 103                   | pinvocacion

 104  pinvocacion : expresion FLECHA ID
 105              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
 106              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
 107              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
 108              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
 109              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
 110              | expresion FLECHA

 111  expresion : expresion '+' termino
 112            | expresion '-' termino
 113            | error '+' termino
 114            | expresion '+' error
 115            | error '-' termino
 116            | expresion '-' error
 117            | termino

 118  termino : termino '*' factor
 119          | termino '/' factor
 120          | error '*' factor
 121          | termino '*' error
 122          | error '/' factor
 123          | termino '/' error
 124          | termino error factor
 125          | factor

 126  factor : CTE
 127         | '-' CTE
 128         | identificador
 129         | funcion
 130         | TRUNC '(' CTE ')'
 131         | TRUNC '(' '-' CTE ')'

 132  listaconstantes : listaconstantes ',' CTE
 133                  | listaconstantes ',' '-' CTE
 134                  | CTE
 135                  | '-' CTE
 136                  | listaconstantes CTE
 137                  | listaconstantes '-' CTE

