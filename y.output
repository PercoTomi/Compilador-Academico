   0  $accept : prog $end

   1  prog : ID '{' listasentencia '}'
   2       | '{' listasentencia '}'
   3       | ID '{' listasentencia
   4       | ID listasentencia '}'
   5       | ID listasentencia

   6  listasentencia : listasentencia sentencia ';'
   7                 | sentencia ';'
   8                 | listasentencia sentencia
   9                 | sentencia

  10  sentencia : asignacion
  11            | declaracion
  12            | control
  13            | print
  14            | funcion

  15  declaracion : tipo listavariables
  16              | tipo ID '(' listaparametros ')' '{' listasentencia RETURN '(' expresion ')' ';' '}'

  17  asignacion : identificador ASIG expresion
  18             | listavariables '=' listaconstantes

  19  listaconstantes : listaconstantes ',' CTE
  20                  | CTE
  21                  | listaconstantes CTE

  22  cuerpo_bloque : '{' listasentencia '}'
  23                | sentencia
  24                | '{' '}'

  25  control : IF '(' condicion ')' cuerpo_bloque ELSE cuerpo_bloque ENDIF
  26          | IF '(' condicion ')' cuerpo_bloque ENDIF
  27          | DO cuerpo_bloque UNTIL '(' condicion ')'
  28          | IF condicion ')' cuerpo_bloque ELSE cuerpo_bloque ENDIF
  29          | IF '(' condicion cuerpo_bloque ELSE cuerpo_bloque ENDIF
  30          | IF condicion cuerpo_bloque ELSE cuerpo_bloque ENDIF
  31          | IF condicion ')' cuerpo_bloque ENDIF
  32          | IF '(' condicion cuerpo_bloque ENDIF
  33          | IF condicion cuerpo_bloque ENDIF
  34          | IF '(' condicion ')' cuerpo_bloque ELSE cuerpo_bloque error
  35          | IF '(' condicion ')' cuerpo_bloque error
  36          | IF '(' condicion ')' cuerpo_bloque ELSE ENDIF
  37          | IF '(' condicion ')' ELSE cuerpo_bloque ENDIF
  38          | IF '(' condicion ')' ENDIF
  39          | IF '(' condicion ')' ELSE ENDIF
  40          | DO cuerpo_bloque UNTIL condicion ')'
  41          | DO cuerpo_bloque UNTIL '(' condicion
  42          | DO cuerpo_bloque UNTIL condicion
  43          | DO UNTIL '(' condicion ')'
  44          | DO cuerpo_bloque error '(' condicion ')'

  45  print : PRINT '(' expresion ')'
  46        | PRINT '(' CADENAML ')'
  47        | PRINT '(' ')'

  48  funcion : ID '(' listapinvocacion ')'
  49          | ID '(' identificador ')'
  50          | ID '(' CTE ')'
  51          | error '(' listapinvocacion ')'
  52          | error '(' identificador ')'
  53          | error '(' CTE ')'

  54  condicion : expresion comparador expresion

  55  comparador : '>'
  56             | '<'
  57             | MAYORIG
  58             | MENORIG
  59             | IGUAL
  60             | DISTINTO

  61  tipo : LONG
  62       | LAMBDA

  63  identificador : ID
  64                | identificador '.' ID

  65  listavariables : listavariables ',' identificador
  66                 | identificador

  67  listaparametros : listaparametros ',' parametro
  68                  | parametro

  69  parametro : CV tipo ID
  70            | tipo ID

  71  expresion : expresion '+' termino
  72            | expresion '-' termino
  73            | termino
  74            | expresion '+' error
  75            | expresion '-' error
  76            | error '+' termino
  77            | error '-' termino

  78  termino : termino '*' factor
  79          | termino '/' factor
  80          | factor
  81          | termino '*' error
  82          | termino '/' error
  83          | error '*' factor
  84          | error '/' factor

  85  factor : identificador
  86         | CTE
  87         | funcion

  88  listapinvocacion : listapinvocacion ',' pinvocacion
  89                   | pinvocacion

  90  pinvocacion : expresion FLECHA ID
  91              | TRUNC '(' expresion ')' FLECHA ID
  92              | '(' tipo ID ')' '{' listasentencia '}'

