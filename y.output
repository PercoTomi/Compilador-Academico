   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | ID '{' '}' EOF
   3       | '{' listasentencias '}' EOF
   4       | ID '{' listasentencias EOF
   5       | ID listasentencias '}' EOF
   6       | ID listasentencias EOF
   7       | '{' listasentencias EOF
   8       | listasentencias '}' EOF
   9       | listasentencias EOF
  10       | ID '{' error ';' listasentencias '}' EOF

  11  listasentencias : listasentencias sentencia
  12                  | sentencia

  13  sentencia : sentenciaejecutable ';'
  14            | declaracion ';'
  15            | sentenciaejecutable
  16            | declaracion

  17  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  18                             | sentenciaejecutable ';'
  19                             | listasentenciasejecutables sentenciaejecutable
  20                             | sentenciaejecutable

  21  sentenciaejecutable : asignacion
  22                      | control
  23                      | funcion
  24                      | print
  25                      | funcion_lambda
  26                      | sentencia_return

  27  declaracion : tipo listavariables

  28  $$1 :

  29  declaracion : tipo ID '(' listaparametros ')' $$1 '{' listasentencias '}'

  30  sentencia_return : RETURN '(' expresion ')' ';'
  31                   | RETURN '(' ')' ';'

  32  asignacion : identificador ASIG expresion
  33             | listavariables '=' listaconstantes

  34  estructura_bloque_control : '{' listasentenciasejecutables '}'
  35                            | sentenciaejecutable ';'
  36                            | '{' '}'

  37  $$2 :

  38  bloque_control_if : $$2 estructura_bloque_control

  39  control : IF condicion bloque_control_if ELSE bloque_control_if ENDIF
  40          | IF condicion bloque_control_if ENDIF
  41          | DO bloque_control_if UNTIL condicion
  42          | IF condicion bloque_control_if ELSE bloque_control_if
  43          | IF condicion bloque_control_if
  44          | IF condicion bloque_control_if ELSE ENDIF
  45          | IF condicion ELSE bloque_control_if ENDIF
  46          | IF condicion ENDIF
  47          | IF condicion ELSE ENDIF
  48          | DO UNTIL condicion
  49          | DO estructura_bloque_control condicion

  50  print : PRINT '(' expresion ')'
  51        | PRINT '(' CADENAML ')'
  52        | PRINT '(' ')'

  53  condicion : '(' cuerpocondicion ')'
  54            | cuerpocondicion ')'
  55            | '(' cuerpocondicion
  56            | cuerpocondicion

  57  cuerpocondicion : expresion comparador expresion
  58                  | expresion

  59  comparador : '>'
  60             | '<'
  61             | MAYORIG
  62             | MENORIG
  63             | IGUAL
  64             | DISTINTO

  65  tipo : LONG
  66       | LAMBDA

  67  listavariables : listavariables ',' identificador
  68                 | identificador

  69  identificador : ID
  70                | identificador '.' ID

  71  funcion : ID '(' argumentos_funcion ')'

  72  funcion_lambda : ID '(' identificador ')'
  73                 | ID '(' CTE ')'
  74                 | ID '(' '-' CTE ')'

  75  argumentos_funcion : listapinvocacion

  76  listapinvocacion : listapinvocacion ',' pinvocacion
  77                   | pinvocacion

  78  pinvocacion : expresion FLECHA ID
  79              | TRUNC '(' expresion ')' FLECHA ID
  80              | TRUNC '(' expresion FLECHA ID
  81              | TRUNC expresion ')' FLECHA ID
  82              | TRUNC expresion FLECHA ID
  83              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
  84              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
  85              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
  86              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
  87              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
  88              | expresion FLECHA
  89              | TRUNC '(' expresion ')' FLECHA

  90  listaparametros : listaparametros ',' parametro
  91                  | parametro

  92  parametro : CV tipo ID
  93            | tipo ID
  94            | CV tipo
  95            | tipo
  96            | CV ID
  97            | ID

  98  expresion : expresion '+' termino
  99            | expresion '-' termino
 100            | error '+' termino
 101            | expresion '+' error
 102            | error '-' termino
 103            | expresion '-' error
 104            | termino

 105  termino : termino '*' factor
 106          | termino '/' factor
 107          | error '*' factor
 108          | termino '*' error
 109          | error '/' factor
 110          | termino '/' error
 111          | termino error factor
 112          | factor

 113  factor : CTE
