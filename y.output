   0  $accept : prog $end

   1  prog : ID '{' listasentencia '}'
   2       | '{' listasentencia '}'
   3       | ID '{' listasentencia
   4       | ID listasentencia '}'
   5       | ID listasentencia

   6  listasentencia : listasentencia sentencia ';'
   7                 | sentencia ';'
   8                 | error

   9  sentencia : asignacion
  10            | declaracion
  11            | control
  12            | print
  13            | funcion

  14  declaracion : tipo listavariables
  15              | tipo ID '(' listaparametros ')' '{' listasentencia RETURN '(' expresion ')' ';' '}'

  16  asignacion : identificador ASIG expresion
  17             | listavariables '=' listaconstantes

  18  listaconstantes : listaconstantes ',' CTE
  19                  | CTE
  20                  | listaconstantes CTE

  21  control : IF condicion '{' listasentencia '}' ELSE '{' listasentencia '}' ENDIF
  22          | IF condicion '{' listasentencia '}' ENDIF
  23          | DO '{' listasentencia '}' UNTIL condicion
  24          | IF condicion '{' listasentencia '}' ELSE '{' listasentencia '}'
  25          | IF condicion '{' listasentencia '}'
  26          | IF condicion '{' listasentencia '}' ELSE '{' '}' ENDIF
  27          | IF condicion '{' '}' ELSE '{' listasentencia '}' ENDIF
  28          | IF condicion '{' '}' ENDIF
  29          | IF condicion '{' '}' ELSE '{' '}' ENDIF
  30          | DO '{' '}' UNTIL condicion
  31          | DO '{' listasentencia '}' condicion

  32  print : PRINT '(' expresion ')'
  33        | PRINT '(' CADENAML ')'
  34        | PRINT '(' ')'

  35  condicion : '(' cuerpocondicion ')'
  36            | cuerpocondicion ')'
  37            | '(' cuerpocondicion
  38            | cuerpocondicion

  39  cuerpocondicion : expresion comparador expresion
  40                  | expresion expresion

  41  comparador : '>'
  42             | '<'
  43             | MAYORIG
  44             | MENORIG
  45             | IGUAL
  46             | DISTINTO

  47  tipo : LONG
  48       | LAMBDA

  49  identificador : ID
  50                | identificador '.' ID

  51  listavariables : listavariables ',' identificador
  52                 | identificador
  53                 | listavariables ID
  54                 | listavariables identificador '.' ID

  55  listaparametros : listaparametros ',' parametro
  56                  | parametro

  57  parametro : CV tipo ID
  58            | tipo ID
  59            | CV tipo
  60            | tipo
  61            | CV ID
  62            | ID

  63  expresion : expresion '+' termino
  64            | expresion '-' termino
  65            | termino
  66            | expresion '+' error
  67            | expresion '-' error
  68            | error '+' termino
  69            | error '-' termino
  70            | expresion error termino

  71  termino : termino '*' factor
  72          | termino '/' factor
  73          | factor
  74          | termino '*' error
  75          | termino '/' error
  76          | error '*' factor
  77          | error '/' factor

  78  factor : identificador
  79         | CTE
  80         | funcion

  81  funcion : ID '(' listapinvocacion ')'
  82          | ID '(' identificador ')'
  83          | ID '(' CTE ')'
  84          | error '(' listapinvocacion ')'
  85          | error '(' identificador ')'
  86          | error '(' CTE ')'

  87  listapinvocacion : listapinvocacion ',' pinvocacion
  88                   | pinvocacion

  89  pinvocacion : expresion FLECHA ID
  90              | TRUNC '(' expresion ')' FLECHA ID
  91              | TRUNC '(' expresion FLECHA ID
  92              | TRUNC expresion ')' FLECHA ID
  93              | TRUNC expresion FLECHA ID
  94              | '(' tipo ID ')' '{' listasentencia '}'
  95              | '(' tipo ID ')' '{' listasentencia
  96              | '(' tipo ID ')' listasentencia '}'
  97              | '(' tipo ID ')' listasentencia
  98              | expresion FLECHA
  99              | TRUNC '(' expresion ')' FLECHA

