  30  listaparametros : listaparametros ',' parametro
  31                  | parametro

  32  parametro : CV tipo ID
  33            | tipo ID

  34  expresion : expresion '+' termino
  35            | expresion '-' termino
  36            | termino

  37  listaexpresiones : listaexpresiones ',' expresion
  38                   | expresion

  39  termino : termino '*' factor
  40          | termino '/' factor
  41          | factor

  42  factor : ID
  43         | CTE
  44         | funcion

  45  funcion : ID '(' listapinvocacion ')'
  46          | ID '(' ID ')'
  47          | ID '(' CTE ')'

  48  listapinvocacion : listapinvocacion ',' pinvocacion
  49                   | pinvocacion

  50  pinvocacion : expresion FLECHA ID
  51              | TRUNC '(' expresion ')' FLECHA ID
  52              | '(' tipo ID ')' '{' listasentencia '}'

