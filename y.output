   0  $accept : prog $end

   1  $$1 :

   2  $$2 :

   3  prog : ID $$1 bloque_sentencias $$2 EOF
   4       | bloque_sentencias EOF

   5  bloque_sentencias : '{' listasentencias '}'
   6                    | '{' '}'
   7                    | '{' listasentencias
   8                    | listasentencias '}'
   9                    | listasentencias

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion

  16  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  17                             | sentenciaejecutable ';'
  18                             | listasentenciasejecutables sentenciaejecutable
  19                             | sentenciaejecutable

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | funcion
  23                      | print
  24                      | funcion_lambda
  25                      | sentencia_return

  26  declaracion : tipo listaIDs

  27  $$3 :

  28  $$4 :

  29  $$5 :

  30  declaracion : tipo id_funcion $$3 '(' listaparametros $$4 ')' $$5 '{' listasentencias '}'

  31  id_funcion : ID

  32  sentencia_return : RETURN '(' expresion ')'
  33                   | RETURN '(' ')'

  34  asignacion : identificador ASIG expresion
  35             | listavariables '=' listaconstantes

  36  bloque_control_estructura : '{' listasentenciasejecutables '}'
  37                            | sentenciaejecutable ';'
  38                            | '{' '}'

  39  $$6 :

  40  bloque_control : $$6 bloque_control_estructura

  41  inicio_do : DO

  42  $$7 :

  43  bloque_control_else : $$7 bloque_control

  44  control : IF condicion bloque_control ELSE bloque_control_else ENDIF
  45          | IF condicion bloque_control ENDIF
  46          | inicio_do bloque_control UNTIL condicion
  47          | IF condicion bloque_control ELSE bloque_control_else
  48          | IF condicion bloque_control
  49          | IF condicion bloque_control ELSE ENDIF
  50          | IF condicion ELSE bloque_control_else ENDIF
  51          | IF condicion ENDIF
  52          | IF condicion ELSE ENDIF
  53          | DO UNTIL condicion
  54          | inicio_do bloque_control condicion

  55  print : PRINT '(' expresion ')'
  56        | PRINT '(' CADENAML ')'
  57        | PRINT '(' ')'

  58  condicion : '(' cuerpocondicion ')'
  59            | cuerpocondicion ')'
  60            | '(' cuerpocondicion
  61            | cuerpocondicion

  62  cuerpocondicion : expresion comparador expresion
  63                  | expresion

  64  comparador : '>'
  65             | '<'
  66             | MAYORIG
  67             | MENORIG
  68             | IGUAL
  69             | DISTINTO

  70  tipo : LONG
  71       | LAMBDA

  72  listaIDs : listaIDs ',' ID
  73           | ID

  74  listavariables : listavariables ',' identificador
  75                 | identificador

  76  identificador : ID
  77                | identificador '.' ID

  78  listaparametros : listaparametros ',' parametro_formal
  79                  | parametro_formal

  80  parametro_formal : CV tipo ID
  81                   | tipo ID
  82                   | CV tipo
  83                   | tipo
  84                   | CV ID
  85                   | ID

  86  funcion : cabecera_funcion argumentos_funcion ')'

  87  funcion_lambda : cabecera_funcion argumento_id_lambda ')'

  88  $$8 :

  89  funcion_lambda : cabecera_funcion CTE ')' $$8

  90  $$9 :

  91  funcion_lambda : cabecera_funcion '-' CTE ')' $$9

  92  $$10 :

  93  funcion_lambda : cabecera_funcion TRUNC '(' CTE ')' ')' $$10

  94  $$11 :

  95  funcion_lambda : cabecera_funcion TRUNC '(' '-' CTE ')' ')' $$11

  96  argumento_id_lambda : identificador

  97  cabecera_funcion : identificador '('

  98  argumentos_funcion : listapinvocacion

  99  listapinvocacion : listapinvocacion ',' pinvocacion
 100                   | pinvocacion

 101  pinvocacion : expresion FLECHA ID
 102              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA ID
 103              | '(' tipo ID ')' '{' listasentenciasejecutables FLECHA ID
 104              | '(' tipo ID ')' listasentenciasejecutables '}' FLECHA ID
 105              | '(' tipo ID ')' listasentenciasejecutables FLECHA ID
 106              | '(' tipo ID ')' '{' listasentenciasejecutables '}' FLECHA
 107              | expresion FLECHA

 108  expresion : expresion '+' termino
 109            | expresion '-' termino
 110            | error '+' termino
 111            | expresion '+' error
 112            | error '-' termino
 113            | expresion '-' error
 114            | termino

 115  termino : termino '*' factor
 116          | termino '/' factor
 117          | error '*' factor
 118          | termino '*' error
 119          | error '/' factor
 120          | termino '/' error
 121          | termino error factor
 122          | factor

 123  factor : CTE
 124         | '-' CTE
 125         | identificador
 126         | funcion
 127         | TRUNC '(' CTE ')'
 128         | TRUNC '(' '-' CTE ')'

 129  listaconstantes : listaconstantes ',' CTE
 130                  | listaconstantes ',' '-' CTE
 131                  | CTE
 132                  | '-' CTE
 133                  | listaconstantes CTE
 134                  | listaconstantes '-' CTE

