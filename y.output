   0  $accept : prog $end

   1  prog : ID '{' listasentencia '}'
   2       | '{' listasentencia '}'
   3       | ID '{' listasentencia
   4       | ID listasentencia '}'
   5       | ID listasentencia

   6  listasentencia : listasentencia sentencia ';'
   7                 | sentencia ';'
   8                 | error

   9  sentencia : asignacion
  10            | declaracion
  11            | control
  12            | print
  13            | funcion

  14  declaracion : tipo listavariables
  15              | tipo ID '(' listaparametros ')' '{' listasentencia RETURN '(' expresion ')' ';' '}'

  16  asignacion : identificador ASIG expresion
  17             | listavariables '=' listaconstantes

  18  listaconstantes : listaconstantes ',' CTE
  19                  | CTE
  20                  | listaconstantes CTE

  21  control : IF '(' condicion ')' '{' listasentencia '}' ELSE '{' listasentencia '}' ENDIF
  22          | IF '(' condicion ')' '{' listasentencia '}' ENDIF
  23          | DO '{' listasentencia '}' UNTIL '(' condicion ')'
  24          | IF condicion ')' '{' listasentencia '}' ELSE '{' listasentencia '}' ENDIF
  25          | IF '(' condicion '{' listasentencia '}' ELSE '{' listasentencia '}' ENDIF
  26          | IF condicion '{' listasentencia '}' ELSE '{' listasentencia '}' ENDIF
