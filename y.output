   0  $accept : prog $end

   1  prog : ID '{' listasentencias '}' EOF
   2       | '{' listasentencias '}' EOF
   3       | ID '{' listasentencias EOF
   4       | ID listasentencias '}' EOF
   5       | ID listasentencias EOF

   6  $$1 :

   7  prog : ID '{' listasentencias error EOF $$1 '}'

   8  $$2 :

   9  prog : ID '{' error EOF $$2 '}'
  10       | ID '{' listasentencias error '}' EOF
  11       | ID '{' error '}' EOF

  12  listasentencias : listasentencias sentencia
  13                  | sentencia
  14                  | listasentencias error ';'
  15                  | error ';'

  16  sentencia : sentenciaejecutable ';'
  17            | declaracion ';'

  18  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  19                             | sentenciaejecutable ';'

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | print

  23  declaracion : tipo listavariables
  24              | tipo ID '(' listaparametros ')' '{' listasentencias RETURN '(' expresion ')' ';' '}'

  25  asignacion : identificador ASIG expresion
  26             | listavariables '=' listaconstantes

  27  listaconstantes : listaconstantes ',' CTE
  28                  | CTE
  29                  | listaconstantes CTE

  30  cuerpo_control : '{' listasentenciasejecutables '}'
  31                 | '{' '}'

  32  control : IF condicion cuerpo_control ELSE cuerpo_control ENDIF
  33          | IF condicion cuerpo_control ENDIF
  34          | DO cuerpo_control UNTIL condicion
  35          | IF condicion cuerpo_control ELSE cuerpo_control
  36          | IF condicion cuerpo_control
  37          | IF condicion cuerpo_control ELSE ENDIF
  38          | IF condicion ELSE cuerpo_control ENDIF
  39          | IF condicion ENDIF
  40          | IF condicion ELSE ENDIF
  41          | DO UNTIL condicion
  42          | DO cuerpo_control condicion

  43  print : PRINT '(' expresion ')'
  44        | PRINT '(' CADENAML ')'
  45        | PRINT '(' ')'

  46  condicion : '(' cuerpocondicion ')'
  47            | cuerpocondicion ')'
  48            | '(' cuerpocondicion
  49            | cuerpocondicion

  50  cuerpocondicion : expresion comparador expresion
  51                  | expresion expresion

  52  comparador : '>'
  53             | '<'
  54             | MAYORIG
  55             | MENORIG
  56             | IGUAL
  57             | DISTINTO

  58  tipo : LONG
  59       | LAMBDA

  60  identificador : ID
  61                | identificador '.' ID

  62  listavariables : listavariables ',' identificador
  63                 | identificador
  64                 | listavariables ID
  65                 | listavariables identificador '.' ID

  66  listaparametros : listaparametros ',' parametro
  67                  | parametro

  68  parametro : CV tipo ID
  69            | tipo ID
  70            | CV tipo
  71            | tipo
  72            | CV ID
  73            | ID

  74  expresion : expresion '+' termino
  75            | expresion '-' termino
  76            | termino
  77            | expresion '+' error
  78            | expresion '-' error
  79            | error '+' termino
  80            | error '-' termino
  81            | expresion error termino

  82  termino : termino '*' factor
  83          | termino '/' factor
  84          | factor
  85          | termino '*' error
  86          | termino '/' error
  87          | error '*' factor
  88          | error '/' factor

  89  factor : identificador
  90         | CTE
  91         | funcion

  92  funcion : ID '(' listapinvocacion ')'
  93          | ID '(' identificador ')'
  94          | ID '(' CTE ')'
  95          | error '(' listapinvocacion ')'
  96          | error '(' identificador ')'
  97          | error '(' CTE ')'

  98  listapinvocacion : listapinvocacion ',' pinvocacion
  99                   | pinvocacion

 100  pinvocacion : expresion FLECHA ID
 101              | TRUNC '(' expresion ')' FLECHA ID
 102              | TRUNC '(' expresion FLECHA ID
 103              | TRUNC expresion ')' FLECHA ID
 104              | TRUNC expresion FLECHA ID
