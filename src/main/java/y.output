 115              | expresion FLECHA

 116  cabecera_declaracion_lambda : '(' tipo ID ')'
 117                              | tipo ID ')'
 118                              | '(' tipo ID

 119  expresion : expresion '+' termino
 120            | expresion '-' termino
 121            | error '+' termino
 122            | expresion '+' error
 123            | error '-' termino
 124            | expresion '-' error
 125            | termino

 126  termino : termino '*' factor
 127          | termino '/' factor
 128          | error '*' factor
 129          | termino '*' error
 130          | error '/' factor
 131          | termino '/' error
 132          | factor
 133          | termino CTE

 134  factor : CTE
 135         | '-' CTE
 136         | identificador
 137         | funcion
 138         | funcion_lambda
 139         | TRUNC '(' CTE ')'
 140         | TRUNC '(' '-' CTE ')'

 141  listaconstantes : listaconstantes ',' CTE
 142                  | listaconstantes ',' '-' CTE
 143                  | CTE
 144                  | '-' CTE
 145                  | listaconstantes CTE
 146                  | listaconstantes '-' CTE
 147                  | listaconstantes ',' identificador

 148  lista_expresiones : listavariables ',' listaconstantes

