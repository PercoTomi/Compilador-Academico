   0  $accept : prog $end

   1  $$1 :

   2  $$2 :

   3  prog : ID $$1 bloque_sentencias $$2 EOF
   4       | bloque_sentencias EOF

   5  bloque_sentencias : '{' listasentencias '}'
   6                    | '{' '}'
   7                    | '{' listasentencias
   8                    | listasentencias '}'
   9                    | listasentencias

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion
  16            | error ';'

  17  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  18                             | sentenciaejecutable ';'
  19                             | listasentenciasejecutables sentenciaejecutable
  20                             | sentenciaejecutable

  21  sentenciaejecutable : asignacion
  22                      | control
  23                      | funcion
  24                      | print
  25                      | funcion_lambda
  26                      | sentencia_return

  27  declaracion : tipo listaIDs

  28  $$3 :

  29  $$4 :

  30  declaracion : tipo id_funcion $$3 parametros_declaracion_f $$4 '{' listasentencias '}'

  31  parametros_declaracion_f : '(' listaparametros ')'
  32                           | '(' ')'

  33  listaparametros : listaparametros ',' parametro_formal
  34                  | parametro_formal

  35  parametro_formal : CV tipo ID
  36                   | tipo ID
  37                   | CV tipo
  38                   | tipo
  39                   | CV ID
  40                   | ID

  41  id_funcion : ID

  42  sentencia_return : RETURN '(' expresion ')'
  43                   | RETURN '(' expresion
  44                   | RETURN expresion ')'
  45                   | RETURN expresion
  46                   | RETURN '(' ')'

  47  asignacion : identificador ASIG expresion
  48             | listavariables '=' listaconstantes
  49             | listavariables '=' listavariables
  50             | listavariables '=' lista_expresiones

  51  bloque_control_estructura : '{' listasentenciasejecutables '}'
  52                            | sentenciaejecutable ';'
  53                            | '{' '}'

  54  $$5 :

  55  bloque_control : $$5 bloque_control_estructura

  56  inicio_do : DO

  57  $$6 :

  58  bloque_control_else : $$6 bloque_control

  59  control : IF condicion bloque_control ENDIF
  60          | IF condicion bloque_control ELSE bloque_control_else ENDIF
  61          | inicio_do bloque_control UNTIL condicion
  62          | IF condicion bloque_control ELSE bloque_control_else
  63          | IF condicion bloque_control
  64          | IF condicion bloque_control ELSE ENDIF
  65          | IF condicion ELSE bloque_control_else ENDIF
  66          | IF condicion ENDIF
  67          | IF condicion ELSE ENDIF
  68          | DO UNTIL condicion
  69          | inicio_do bloque_control condicion

  70  print : PRINT '(' argumento_print ')'
  71        | PRINT '(' ')'
  72        | PRINT argumento_print ')'
  73        | PRINT '(' argumento_print
  74        | PRINT argumento_print

  75  argumento_print : expresion
  76                  | CADENAML

  77  condicion : '(' cuerpocondicion ')'
  78            | cuerpocondicion ')'
  79            | '(' cuerpocondicion
  80            | cuerpocondicion

  81  cuerpocondicion : expresion comparador expresion
  82                  | expresion

  83  comparador : '>'
  84             | '<'
  85             | MAYORIG
  86             | MENORIG
  87             | IGUAL
  88             | DISTINTO

  89  tipo : LONG
  90       | LAMBDA

  91  listaIDs : listaIDs ',' ID
  92           | ID

  93  listavariables : listavariables ',' identificador
  94                 | identificador

  95  identificador : ID
  96                | identificador '.' ID

  97  funcion : cabecera_funcion argumentos_funcion ')'
  98          | cabecera_funcion ')'

  99  funcion_lambda : cabecera_funcion argumento_id_lambda ')'
 100                 | cabecera_funcion CTE ')'
 101                 | cabecera_funcion '-' CTE ')'
 102                 | cabecera_funcion TRUNC '(' CTE ')' ')'
 103                 | cabecera_funcion TRUNC '(' '-' CTE ')' ')'

 104  argumento_id_lambda : identificador

 105  cabecera_funcion : identificador '('

 106  argumentos_funcion : listapinvocacion

 107  listapinvocacion : listapinvocacion ',' pinvocacion
 108                   | pinvocacion

 109  pinvocacion : expresion FLECHA ID
 110              | cabecera_declaracion_lambda '{' listasentenciasejecutables '}' FLECHA ID
 111              | cabecera_declaracion_lambda '{' listasentenciasejecutables FLECHA ID
