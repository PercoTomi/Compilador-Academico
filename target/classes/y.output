   0  $accept : prog $end

   1  $$1 :

   2  $$2 :

   3  prog : ID $$1 bloque_sentencias $$2 EOF
   4       | bloque_sentencias EOF

   5  bloque_sentencias : '{' listasentencias '}'
   6                    | '{' '}'
   7                    | '{' listasentencias
   8                    | listasentencias '}'
   9                    | listasentencias

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion

  16  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  17                             | sentenciaejecutable ';'
  18                             | listasentenciasejecutables sentenciaejecutable
  19                             | sentenciaejecutable

  20  sentenciaejecutable : asignacion
  21                      | control
  22                      | funcion
  23                      | print
  24                      | funcion_lambda
  25                      | sentencia_return

  26  declaracion : tipo listaIDs

  27  $$3 :

  28  $$4 :

  29  declaracion : tipo id_funcion $$3 parametros_declaracion_f $$4 '{' listasentencias '}'

  30  parametros_declaracion_f : '(' listaparametros ')'
  31                           | '(' ')'

  32  listaparametros : listaparametros ',' parametro_formal
  33                  | parametro_formal

  34  parametro_formal : CV tipo ID
  35                   | tipo ID
  36                   | CV tipo
  37                   | tipo
  38                   | CV ID
  39                   | ID

  40  id_funcion : ID

  41  sentencia_return : RETURN '(' expresion ')'
  42                   | RETURN '(' expresion
  43                   | RETURN expresion ')'
  44                   | RETURN expresion
  45                   | RETURN '(' ')'

  46  asignacion : identificador ASIG expresion
  47             | listavariables '=' listaconstantes
  48             | listavariables '=' listavariables

  49  bloque_control_estructura : '{' listasentenciasejecutables '}'
  50                            | sentenciaejecutable ';'
  51                            | '{' '}'

  52  $$5 :

  53  bloque_control : $$5 bloque_control_estructura

  54  inicio_do : DO

  55  $$6 :

  56  bloque_control_else : $$6 bloque_control

  57  control : IF condicion bloque_control ENDIF
  58          | IF condicion bloque_control ELSE bloque_control_else ENDIF
  59          | inicio_do bloque_control UNTIL condicion
  60          | IF condicion bloque_control ELSE bloque_control_else
  61          | IF condicion bloque_control
  62          | IF condicion bloque_control ELSE ENDIF
  63          | IF condicion ELSE bloque_control_else ENDIF
  64          | IF condicion ENDIF
  65          | IF condicion ELSE ENDIF
  66          | DO UNTIL condicion
  67          | inicio_do bloque_control condicion

  68  print : PRINT '(' argumento_print ')'
  69        | PRINT '(' ')'
  70        | PRINT argumento_print ')'
  71        | PRINT '(' argumento_print
  72        | PRINT argumento_print

  73  argumento_print : expresion
  74                  | CADENAML

  75  condicion : '(' cuerpocondicion ')'
  76            | cuerpocondicion ')'
  77            | '(' cuerpocondicion
  78            | cuerpocondicion

  79  cuerpocondicion : expresion comparador expresion
  80                  | expresion

  81  comparador : '>'
  82             | '<'
  83             | MAYORIG
  84             | MENORIG
  85             | IGUAL
  86             | DISTINTO

  87  tipo : LONG
  88       | LAMBDA

  89  listaIDs : listaIDs ',' ID
  90           | ID

  91  listavariables : listavariables ',' identificador
  92                 | identificador

  93  identificador : ID
  94                | identificador '.' ID

  95  funcion : cabecera_funcion argumentos_funcion ')'
  96          | cabecera_funcion ')'

  97  funcion_lambda : cabecera_funcion argumento_id_lambda ')'
  98                 | cabecera_funcion CTE ')'
  99                 | cabecera_funcion '-' CTE ')'
 100                 | cabecera_funcion TRUNC '(' CTE ')' ')'
 101                 | cabecera_funcion TRUNC '(' '-' CTE ')' ')'

 102  argumento_id_lambda : identificador

 103  cabecera_funcion : identificador '('

 104  argumentos_funcion : listapinvocacion

 105  listapinvocacion : listapinvocacion ',' pinvocacion
 106                   | pinvocacion

 107  pinvocacion : expresion FLECHA ID
 108              | cabecera_declaracion_lambda '{' listasentenciasejecutables '}' FLECHA ID
 109              | cabecera_declaracion_lambda '{' listasentenciasejecutables FLECHA ID
 110              | cabecera_declaracion_lambda listasentenciasejecutables '}' FLECHA ID
 111              | cabecera_declaracion_lambda listasentenciasejecutables FLECHA ID
 112              | cabecera_declaracion_lambda '{' listasentenciasejecutables '}' FLECHA
 113              | expresion FLECHA

 114  cabecera_declaracion_lambda : '(' tipo ID ')'
 115                              | tipo ID ')'
 116                              | '(' tipo ID

 117  expresion : expresion '+' termino
 118            | expresion '-' termino
 119            | error '+' termino
 120            | expresion '+' error
 121            | error '-' termino
 122            | expresion '-' error
 123            | termino

 124  termino : termino '*' factor
 125          | termino '/' factor
 126          | error '*' factor
 127          | termino '*' error
 128          | error '/' factor
 129          | termino '/' error
 130          | factor
 131          | termino error factor

 132  factor : CTE
 133         | '-' CTE
 134         | identificador
 135         | funcion
 136         | funcion_lambda
 137         | TRUNC '(' CTE ')'
 138         | TRUNC '(' '-' CTE ')'

 139  listaconstantes : listaconstantes ',' CTE
 140                  | listaconstantes ',' '-' CTE
 141                  | CTE
 142                  | '-' CTE
 143                  | listaconstantes CTE
 144                  | listaconstantes '-' CTE
 145                  | listaconstantes ',' identificador

