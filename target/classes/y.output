 143         | TRUNC '(' '-' CTE ')'

 144  listaconstantes : listaconstantes ',' CTE
 145                  | listaconstantes ',' '-' CTE
 146                  | CTE
 147                  | '-' CTE
 148                  | listaconstantes CTE
 149                  | listaconstantes '-' CTE
 150                  | listaconstantes ',' identificador

 151  lista_expresiones : listavariables ',' listaconstantes

