   0  $accept : prog $end

   1  $$1 :

   2  $$2 :

   3  prog : ID $$1 bloque_sentencias $$2 EOF
   4       | bloque_sentencias EOF

   5  bloque_sentencias : '{' listasentencias '}'
   6                    | '{' '}'
   7                    | '{' listasentencias
   8                    | listasentencias '}'
   9                    | listasentencias

  10  listasentencias : listasentencias sentencia
  11                  | sentencia

  12  sentencia : sentenciaejecutable ';'
  13            | declaracion ';'
  14            | sentenciaejecutable
  15            | declaracion
  16            | error ';'

  17  listasentenciasejecutables : listasentenciasejecutables sentenciaejecutable ';'
  18                             | sentenciaejecutable ';'
  19                             | listasentenciasejecutables sentenciaejecutable
  20                             | sentenciaejecutable

  21  sentenciaejecutable : asignacion
  22                      | control
  23                      | funcion
  24                      | print
  25                      | funcion_lambda
  26                      | sentencia_return

  27  declaracion : tipo listaIDs

  28  $$3 :

  29  $$4 :

  30  declaracion : tipo id_funcion $$3 parametros_declaracion_f $$4 '{' listasentencias '}'

  31  parametros_declaracion_f : '(' listaparametros ')'
  32                           | '(' ')'

  33  listaparametros : listaparametros ',' parametro_formal
  34                  | parametro_formal

  35  parametro_formal : CV tipo ID
  36                   | tipo ID
  37                   | CV tipo
  38                   | tipo
  39                   | CV ID
  40                   | ID

  41  id_funcion : ID

  42  sentencia_return : RETURN '(' expresion ')'
  43                   | RETURN '(' expresion
  44                   | RETURN expresion ')'
  45                   | RETURN expresion
  46                   | RETURN '(' ')'

  47  asignacion : identificador ASIG expresion
  48             | listavariables '=' listaconstantes
  49             | listavariables '=' listavariables
  50             | listavariables '=' lista_expresiones

  51  bloque_control_estructura : '{' listasentenciasejecutables '}'
  52                            | sentenciaejecutable ';'
  53                            | '{' '}'

  54  $$5 :

  55  bloque_control : $$5 bloque_control_estructura

  56  inicio_do : DO '{' listasentenciasejecutables '}'
  57            | DO '{' '}'
  58            | DO sentenciaejecutable ';'

  59  $$6 :

  60  bloque_control_else : $$6 bloque_control

  61  control : IF condicion bloque_control ENDIF
  62          | IF condicion bloque_control ELSE bloque_control_else ENDIF
  63          | inicio_do UNTIL condicion
  64          | DO sentenciaejecutable UNTIL condicion
  65          | IF condicion bloque_control ELSE bloque_control_else
  66          | IF condicion bloque_control
  67          | IF condicion bloque_control ELSE ENDIF
  68          | IF condicion ELSE bloque_control_else ENDIF
  69          | IF condicion ENDIF
  70          | IF condicion ELSE ENDIF
  71          | DO UNTIL condicion
  72          | inicio_do condicion

  73  print : PRINT '(' argumento_print ')'
  74        | PRINT '(' ')'
  75        | PRINT argumento_print ')'
  76        | PRINT '(' argumento_print
  77        | PRINT argumento_print

  78  argumento_print : expresion
  79                  | CADENAML

  80  condicion : '(' cuerpocondicion ')'
  81            | cuerpocondicion ')'
  82            | '(' cuerpocondicion
  83            | cuerpocondicion

  84  cuerpocondicion : expresion comparador expresion
  85                  | expresion

  86  comparador : '>'
  87             | '<'
  88             | MAYORIG
  89             | MENORIG
  90             | IGUAL
  91             | DISTINTO

  92  tipo : LONG
  93       | LAMBDA

  94  listaIDs : listaIDs ',' ID
  95           | ID

  96  listavariables : listavariables ',' identificador
  97                 | identificador

  98  identificador : ID
  99                | identificador '.' ID

 100  funcion : cabecera_funcion argumentos_funcion ')'
 101          | cabecera_funcion ')'

 102  funcion_lambda : cabecera_funcion argumento_id_lambda ')'
 103                 | cabecera_funcion CTE ')'
 104                 | cabecera_funcion '-' CTE ')'
 105                 | cabecera_funcion TRUNC '(' CTE ')' ')'
 106                 | cabecera_funcion TRUNC '(' '-' CTE ')' ')'

 107  argumento_id_lambda : identificador

 108  cabecera_funcion : identificador '('

 109  argumentos_funcion : listapinvocacion

 110  listapinvocacion : listapinvocacion ',' pinvocacion
 111                   | pinvocacion

 112  pinvocacion : expresion FLECHA ID
 113              | cabecera_declaracion_lambda '{' listasentenciasejecutables '}' FLECHA ID
 114              | cabecera_declaracion_lambda '{' listasentenciasejecutables FLECHA ID
