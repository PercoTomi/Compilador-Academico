 117              | cabecera_declaracion_lambda '{' listasentenciasejecutables '}' FLECHA
 118              | expresion FLECHA

 119  cabecera_declaracion_lambda : '(' tipo ID ')'
 120                              | tipo ID ')'
 121                              | '(' tipo ID

 122  expresion : expresion '+' termino
 123            | expresion '-' termino
 124            | error '+' termino
 125            | expresion '+' error
 126            | error '-' termino
 127            | expresion '-' error
 128            | termino

 129  termino : termino '*' factor
 130          | termino '/' factor
 131          | error '*' factor
 132          | termino '*' error
 133          | error '/' factor
 134          | termino '/' error
 135          | factor
 136          | termino CTE

 137  factor : CTE
 138         | '-' CTE
 139         | identificador
 140         | funcion
 141         | funcion_lambda
